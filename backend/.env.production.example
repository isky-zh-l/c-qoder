# Production template. Copy to backend/.env.production.
# Start the process with APP_ENV=production so this file is loaded.
APP_VERSION=0.1.0
PUBLIC_BASE_PATH=/c
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/DB_NAME
SITE_TITLE=C 语言学习笔记
CORS_ORIGINS=https://notes.example.com
FRONTEND_DIST=../frontend/dist
UPLOADS_DIR=data/uploads
STORAGE_TMP_DIR=data/tmp
EXPORTS_DIR=data/exports
BACKUP_DIR=data/backups
PUBLIC_BASE_URL=https://notes.example.com
SESSION_COOKIE_NAME=c_session
SESSION_COOKIE_SECURE=true
SESSION_TTL_DAYS=30
CSRF_COOKIE_NAME=c_csrf
CSRF_HEADER_NAME=X-CSRF-Token
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
RECYCLE_RETENTION_DAYS=7
ACCOUNT_DELETION_RETENTION_DAYS=30
DEFAULT_USER_STORAGE_BYTES=104857600
MAX_FILE_BYTES=2097152
MAX_IMAGE_BYTES=10485760
IMAGE_MAX_DIMENSION=10000
UPLOAD_RESERVATION_MINUTES=10
STORAGE_ORPHAN_GRACE_HOURS=24
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=SMTP_USER
SMTP_PASSWORD=SMTP_PASSWORD
SMTP_FROM=notes@example.com
SMTP_STARTTLS=true
SMTP_TIMEOUT=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUEST_PER_MINUTE=600
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_VERIFY_PER_HOUR=10
RATE_LIMIT_RESEND_PER_HOUR=3
RATE_LIMIT_FORGOT_PER_HOUR=3
RATE_LIMIT_CHANGE_PASSWORD_PER_HOUR=5
